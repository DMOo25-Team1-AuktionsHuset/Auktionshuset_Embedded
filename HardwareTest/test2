//new hardware Tft smoke test

#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>

// SPI pins
#define TFT_MOSI 11
#define TFT_MISO 13
#define TFT_SCLK 12

// Control pins
#define TFT_CS   10
#define TFT_DC    9
#define TFT_RST   8

Adafruit_ILI9341 tft(&SPI, TFT_DC, TFT_CS, TFT_RST);

void setup()
{
    Serial.begin(115200);
    delay(1000);

    Serial.println();
    Serial.println("=== Auction Device 2.0 ===");
    Serial.println("Starting TFT test...");

    // Start SPI bus
    // SCK, MISO, MOSI, CS
    SPI.begin(TFT_SCLK, TFT_MISO, TFT_MOSI, TFT_CS);

    // Start display
    tft.begin();

    // Landscape mode: 320 x 240
    tft.setRotation(1);

    Serial.print("Display size: ");
    Serial.print(tft.width());
    Serial.print(" x ");
    Serial.println(tft.height());

    // Clear screen
    tft.fillScreen(ILI9341_BLACK);

    // Title
    tft.setTextColor(ILI9341_WHITE);
    tft.setTextSize(2);
    tft.setCursor(20, 30);
    tft.println("Auction Device 2.0");

    // Main test
    tft.setTextColor(ILI9341_GREEN);
    tft.setTextSize(3);
    tft.setCursor(20, 90);
    tft.println("TFT OK!");

    // Hardware info
    tft.setTextColor(ILI9341_CYAN);
    tft.setTextSize(2);
    tft.setCursor(20, 150);
    tft.println("ESP32-S3 N16R8");

    Serial.println("TFT initialization complete.");
}

void loop()
{
}
